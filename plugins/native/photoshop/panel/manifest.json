{
  "manifestVersion": 5,
  "id": "com.bruxosdovfx.desfoque.photoshop",
  "name": "Simulador de Desfoque da Bruxosdovfx",
  "version": "0.2.1",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "desfoque",
      "label": {
        "default": "Desfoque da Bruxosdovfx"
      },
      "minimumSize": {
        "width": 320,
        "height": 420
      },
      "maximumSize": {
        "width": 1600,
        "height": 1600
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 750
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 750
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://127.0.0.1:8769"
      ]
    },
    "localFileSystem": "request",
    "launchProcess": {
      "schemes": [],
      "extensions": [
        ".exe"
      ]
    }
  }
}